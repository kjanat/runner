{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"useTabs": true,
	"json": { "jsonTrailingCommaFiles": [".zed/settings.json"], "trailingCommas": "jsonc" },
	"markdown": { "textWrap": "maintain", "emphasisKind": "asterisks" },
	"markup": {
		"associations": ["!**/*.svg"],
		"ignoreCommentDirective": "dprint-ignore",
		"ignoreFileCommentDirective": "dprint-ignore-file",
		"printWidth": 160,
	},
	"shfmt": {
		"associations": ["**/bin/{install-branch,.runner-dev}", "**/*.{bash,zsh,sh}"],
		"useTabs": true,
		"binaryNextLine": true,
		"switchCaseIndent": true,
		"experimentalZsh": true,
	},
	"yaml": { "printWidth": 160 },
	"jsonSchemaSort": { "associations": ["**/schema.json", "**/*.schema.json"] },
	"exec": {
		"cwd": "${configDir}",
		"cacheKey": "1",
		"timeout": 30,
		"commands": [{
			"command": "tombi format - --stdin-filename {{file_path}}",
			"exts": ["toml"],
			"cacheKeyFiles": ["tombi.toml"],
			"setupCommand": "npm i -g tombi",
		}, {
			"command": "rustup run nightly rustfmt --emit stdout",
			"exts": ["rs"],
			"cacheKeyFiles": ["rustfmt.toml", "rust-toolchain.toml", ".cargo/config.toml"],
			"setupCommand": "rustup component add rustfmt --toolchain nightly",
		}, {
			"command": "just --dump --justfile {{file_path}}",
			"fileNames": ["justfile"],
			"setupCommand": "npm i -g rust-just",
		}],
	},
	"excludes": [
		"**/*.lock",
		"**/node_modules",
		"**/samples",
		"**/target",
		"**/dist",
		"**/downloads",
		"schemas/*.example.json",
	],
	"plugins": [
		"https://plugins.dprint.dev/kjanat/json-schema-sort-0.1.2.wasm",
		"https://plugins.dprint.dev/kjanat/shfmt-1.1.1.wasm",
		"https://plugins.dprint.dev/kjanat/sortpackagejson-0.2.1.wasm",
		"https://plugins.dprint.dev/kjanat/svg-v0.4.1.wasm",
		"npm:@dprint/dockerfile@0.6.0",
		"npm:@dprint/json@0.25.0",
		"npm:@dprint/markdown@0.24.0",
		"npm:@dprint/typescript@0.96.1",
		"npm:dprint-plugin-malva@0.16.0",
		"npm:dprint-plugin-markup@0.27.5",
		"npm:dprint-plugin-yaml@0.6.0",
		"npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
	],
}
